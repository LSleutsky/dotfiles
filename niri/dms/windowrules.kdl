// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="firefox"
    open-maximized true
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="com.mitchellh.ghostty"
    open-maximized true
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="zed"
    open-maximized true
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="obsidian"
    open-maximized true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
